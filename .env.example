# 聊天上游(DeepSeek 官方,OpenAI 兼容)。CHAT_MODEL 要写上游认的真实模型名,没有别名这一层
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=sk-xxx

TOKEN_BUDGET=2000

DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_test

# 嵌入 BAAI/bge-m3。BASE_URL 有内置默认值(硅基流动),换上游才需要填
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1

# 重排 BAAI/bge-reranker-v2-m3。BASE_URL 有内置默认值(硅基流动)
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
